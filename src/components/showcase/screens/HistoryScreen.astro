<style>
  .history-screen-layout { padding: 0.8rem; height: 100%; box-sizing: border-box; background: #0f172a; font-family: system-ui, -apple-system, sans-serif; }
  .header-bar { display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.6rem; }
  .header-bar h3 { font-size: 0.8rem; color: #f8fafc; }
  .pill-green { background: rgba(16, 185, 129, 0.2); color: #10b981; font-size: 0.55rem; padding: 0.12rem 0.4rem; border-radius: 9999px; }
  .stats-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 0.4rem; margin-bottom: 0.6rem; }
  .stat-card { background: rgba(255, 255, 255, 0.03); border: 1px solid rgba(255, 255, 255, 0.08); padding: 0.4rem; border-radius: 6px; font-size: 0.58rem; color: #94a3b8; display: flex; flex-direction: column; }
  .stat-card strong { font-size: 0.75rem; margin-top: 0.15rem; }
  .green { color: #10b981 !important; }
  .red { color: #f87171 !important; }
  .log-preview { border: 1px solid rgba(255, 255, 255, 0.08); border-radius: 6px; font-size: 0.62rem; }
  .log-item { display: flex; justify-content: space-between; padding: 0.35rem 0.5rem; border-bottom: 1px solid rgba(255, 255, 255, 0.04); color: #94a3b8; }
</style>
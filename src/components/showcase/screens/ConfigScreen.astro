---
---
<div class="config-screen-layout">
  <h3>Configuración del Sistema</h3>
  <p class="sub">Personaliza tu punto de venta, marca e impresoras.</p>
  <div class="mascots-section">
    <h5>Catálogo Vectorial Adaptable (Lya)</h5>
    <div class="mascots-grid">
      <div class="mascot-chip active">🪼 Clásica</div>
      <div class="mascot-chip">👽 Minimal</div>
      <div class="mascot-chip">🛡️ Cúpula</div>
      <div class="mascot-chip">🤖 Cyber</div>
    </div>
  </div>
</div>

<style>
  .config-screen-layout { padding: 0.8rem; height: 100%; box-sizing: border-box; background: #0f172a; font-family: system-ui, -apple-system, sans-serif; }
  .config-screen-layout h3 { font-size: 0.85rem; color: #f8fafc; margin-bottom: 0.2rem; }
  .sub { font-size: 0.62rem; color: #64748b; margin-bottom: 0.8rem; }
  .mascots-section h5 { font-size: 0.72rem; color: #94a3b8; margin-bottom: 0.5rem; }
  .mascots-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 0.4rem; }
  .mascot-chip { background: rgba(255, 255, 255, 0.03); border: 1px solid rgba(255, 255, 255, 0.08); padding: 0.4rem; border-radius: 5px; font-size: 0.68rem; color: #94a3b8; }
  .mascot-chip.active { border-color: #8b5cf6; color: #a78bfa; background: rgba(139, 92, 246, 0.15); }
</style>